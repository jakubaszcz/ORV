<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ORVReader"
        parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/reader_background</item>
        <item name="android:statusBarColor">@color/reader_background</item>
        <item name="android:navigationBarColor">@color/reader_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.ORVReader.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/reader_background</item>

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/splash_logo
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.ORVReader
        </item>
    </style>

</resources>